<!--
    Locators verified against the module's own rendered output:
    - view/frontend/web/template/payment/razorpay-form.html renders
      input[data-bind="attr: {'id': getCode()}, ..."] where getCode() (in
      razorpay-method.js) returns the literal string "razorpay" -- so the
      real rendered element is input#razorpay.radio, following the same
      convention Magento_Checkout's own CheckoutPaymentSection.xml uses for
      input#checkmo.radio.
    - The submit button is button.action.primary.checkout inside the active
      payment method block, with data-bind title "Pay with Razorpay".
-->
<sections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:mftf:Page/etc/SectionObject.xsd">
    <section name="StorefrontRazorpayPaymentSection">
        <element name="razorpayPaymentRadio" type="radio" selector="input#razorpay.radio" timeout="30"/>
        <element name="payWithRazorpayButton" type="button" selector=".payment-method._active button.action.primary.checkout[title='Pay with Razorpay']" timeout="30"/>
    </section>
</sections>
