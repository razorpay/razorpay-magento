<?xml version="1.0"?>
<ruleset name="RazorpayMagentoPHPCompatibility">
    <description>PHP version compatibility checks for the Razorpay Magento module, independent of the Magento2 coding-standard ruleset.</description>

    <file>Constants</file>
    <file>Controller</file>
    <file>Cron</file>
    <file>Model</file>
    <file>Observer</file>
    <file>Plugin</file>
    <file>Setup</file>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="PHPCompatibility"/>
</ruleset>
