{
    "name": "razorpay/magento",
    "description": "Razorpay Magento 2.0 plugin for accepting payments.",
    "version": "4.2.2",
    "require": {
        "php": "7.*|^8.1",
        "razorpay/razorpay": "2.*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.12",
        "magento/magento-coding-standard": "*",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "magento/php-compatibility-fork": "^0.1"
    },
    "keywords": [
        "razorpay",
        "magento",
        "payments",
        "india",
        "payment gateway",
        "wallets",
        "netbanking"
    ],
    "authors": [
        {
            "name": "Team Razorpay",
            "homepage": "https://razorpay.com/about/",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/razorpay/razorpay-magento",
        "issues": "https://razorpay.com/support/",
        "rss": "https://github.com/razorpay/razorpay-magento/releases.atom",
        "docs":
            "https://docs.razorpay.com/v1/page/integrating-your-magento-store-with-razorpay"
    },
    "homepage": "https://razorpay.com",
    "suggest": {
        "magento/module-checkout-agreements": "100.0.*"
    },
    "type": "magento2-module",
    "license": ["MIT"],
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Razorpay\\Magento\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Razorpay\\Magento\\Test\\Unit\\": "Test/Unit/",
            "Razorpay\\Magento\\Test\\Integration\\": "Test/Integration/",
            "Razorpay\\Magento\\Test\\Mftf\\": "Test/Mftf/"
        }
    },
    "scripts": {
        "test:static": "bin/run-tests.sh static",
        "test:unit": "bin/run-tests.sh unit",
        "test:php-compat": "bin/run-tests.sh compat",
        "test:integration": "bin/run-tests.sh integration",
        "test:all": "bin/run-tests.sh all"
    }
}
